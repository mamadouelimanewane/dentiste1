# Base de données Neon (obligatoire)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Authentification staff - secret de signature des sessions (obligatoire)
SESSION_SECRET=

# Stockage documents patients (obligatoire pour le portail)
BLOB_READ_WRITE_TOKEN=

# WhatsApp - priorité 360dialog > Meta Cloud API > Twilio (le premier
# fournisseur configuré ci-dessous est utilisé) - laisser tout vide pour
# rester en mode démo
D360_API_KEY=

WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# SMS - priorité Termii > Africa's Talking > Vonage > Twilio (le premier
# fournisseur configuré ci-dessous est utilisé) - laisser tout vide pour
# rester en mode démo
TERMII_API_KEY=
TERMII_SENDER_ID=

AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=
AFRICASTALKING_SENDER_ID=

VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_FROM=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# WhatsApp via Twilio Sandbox (alternative rapide à Meta Cloud API ci-dessus,
# utilise les mêmes identifiants TWILIO_* que le SMS) - laisser vide pour
# rester en mode démo. Numéro du Sandbox Twilio, ex: +14155238886
TWILIO_WHATSAPP_FROM=

# Paiement CinetPay - laisser vide pour rester en mode démo
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=

# Visio Daily.co - laisser vide pour rester en mode démo
DAILY_API_KEY=

# Portail patient (lien magique) - secret de signature des sessions portail
PORTAL_SESSION_SECRET=

# Cron des rappels automatiques (Vercel Cron envoie ce secret en Bearer token)
CRON_SECRET=
